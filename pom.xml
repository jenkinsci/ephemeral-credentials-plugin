<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2211.v27f680c93c53</version>
    <relativePath />
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>ephemeral-credentials</artifactId>
  <version>${revision}.${changelist}</version>
  <packaging>hpi</packaging>

  <name>Ephemeral Credentials Plugin</name>
  <description>Run-scoped, in-memory Jenkins CredentialsProvider: resolves credentials only
        for the Pipeline build currently executing, and only what that build itself had cached.
        Nothing it holds is ever written to disk.</description>
  <url>https://github.com/${gitHubRepo}</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/${gitHubRepo}</connection>
    <developerConnection>scm:git:git@github.com:${gitHubRepo}.git</developerConnection>
    <tag>${scmTag}</tag>
    <url>https://github.com/${gitHubRepo}</url>
  </scm>

  <properties>
    <revision>1</revision>
    <changelist>999999-SNAPSHOT</changelist>
    <gitHubRepo>jenkinsci/${project.artifactId}-plugin</gitHubRepo>
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>
    <!-- https://www.jenkins.io/doc/developer/plugin-development/choosing-jenkins-baseline/ -->
    <jenkins.baseline>2.541</jenkins.baseline>
    <jenkins.version>${jenkins.baseline}.3</jenkins.version>
    <no-test-jar>false</no-test-jar>
    <!-- Do not run extra reporting for pmd -->
    <!-- https://stackoverflow.com/questions/12038238/unable-to-locate-source-xref-to-link-to -->
    <linkXRef>false</linkXRef>

    <!-- The parent POM already declares spotless-maven-plugin (Palantir Java
             Format, plus sortPom for pom.xml) bound to `check` at `verify` -
             gated behind this property, off by default ("Set to false to
             enable Spotless" per the parent's own comment). Flipping it here
             is all that's needed; adding a second, separate <plugin>
             declaration would just duplicate the inherited one (and risk
             configuring the wrong formatter). -->
    <spotless.check.skip>false</spotless.check.skip>

    <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>
    <ban-deprecated-stapler.skip>false</ban-deprecated-stapler.skip>
    <banObsoleteDependencyOverrides.skip>false</banObsoleteDependencyOverrides.skip>
    <spotbugs.effort>Max</spotbugs.effort>
    <spotbugs.threshold>Low</spotbugs.threshold>

    <!-- Same as the parent POM's own argLine property, plus the JVM's
             enable-native-access flag (see the literal value below) to
             silence the "restricted method ... System::load ... called by
             com.sun.jna.Native" warning JenkinsRule triggers every test run
             (Jenkins core uses JNA for native process handling). Can't
             extend the parent's
             value with a surefire-side @{argLine} reference instead of
             duplicating it: the parent's argLine already embeds its own
             @{jenkins.addOpens}/@{jenkins.insaneHook}/@{jenkins.javaAgent}
             tokens (set dynamically by maven-hpi-plugin's test-runtime goal),
             and Surefire's @{...} substitution is a single pass - wrapping
             that whole string in another @{argLine} left those inner tokens
             unexpanded and crashed the fork (confirmed: "could not open
             `{jenkins.addOpens}'"). -->
    <argLine>-Xms768M -Xmx768M -XX:+HeapDumpOnOutOfMemoryError -XX:+TieredCompilation -XX:TieredStopAtLevel=1 @{jenkins.addOpens} @{jenkins.insaneHook} @{jenkins.javaAgent} --enable-native-access=ALL-UNNAMED</argLine>
  </properties>

  <!-- Several of our dependencies (workflow-cps / pipeline-input-step /
         lockable-resources) each transitively want their own versions of
         workflow-support, script-security, workflow-api, etc., which trips
         the parent POM's RequireUpperBoundDeps enforcer rule if resolved
         piecemeal. Importing the BOM for this exact core line gives one
         mutually-consistent version set instead of pinning each conflict by
         hand as it's discovered - so most dependencies below omit <version>
         and let the BOM supply it. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-${jenkins.baseline}.x</artifactId>
        <version>6751.v745d6a_31066a_</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <!-- Community plugin, not part of the Jenkins-org BOM - version
                 verified against internal JSL build.gradle.kts, which
                 already pins this exact release for the same core baseline.
        -->
      <groupId>org.6wind.jenkins</groupId>
      <artifactId>lockable-resources</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>credentials</artifactId>
    </dependency>

    <!-- Real (non-test) dependencies: WithEphemeralCredentials.groovy calls
             the `lock` and `input` steps by name, so these must be declared
             here to end up in the plugin's manifest as required dependencies -
             Jenkins should refuse to load this plugin without them installed,
             same as it would for any other step it composes with. Neither is
             referenced from Java, so no compile-time import needed for them. -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>pipeline-input-step</artifactId>
    </dependency>

    <!-- For EphemeralSecretText's StringCredentialsImpl and
             EphemeralSecretFile's FileCredentialsImpl. -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>plain-credentials</artifactId>
    </dependency>

    <!-- For EphemeralSSHUserPrivateKey's BasicSSHUserPrivateKey. Optional:
             installations that never use ephemeralSSHUserPrivateKey don't
             need this plugin installed at all - EphemeralSSHUserPrivateKey's
             constructor detects its absence and fails with a clear message
             instead. Marking it optional here makes maven-hpi-plugin record
             it as an optional plugin dependency in the manifest, so Jenkins
             doesn't refuse to load this whole plugin without it. -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>ssh-credentials</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-cps</artifactId>
    </dependency>

    <!-- Test-only: WithEphemeralCredentialsCustomLibraryTest, illustrating
             a custom credential type defined in a shared library rather than
             in this plugin. -->
    <dependency>
      <groupId>io.jenkins.plugins</groupId>
      <artifactId>pipeline-groovy-lib</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.jenkins-ci.main</groupId>
      <artifactId>jenkins-test-harness</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Test-only: declarative pipeline + JenkinsRule integration tests. -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>credentials-binding</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- GitSCMSource, used directly to configure the test shared library. -->
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>git</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- GitSampleRepoRule - a local, throwaway git repo to load the
                 test shared library from, ships in the git plugin's own
                 test-jar. -->
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>git</artifactId>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- GitSampleRepoRule's own superclass (AbstractSampleDVCSRepoRule,
                 which actually declares write()/mkdirs()) lives here. -->
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>scm-api</artifactId>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-basic-steps</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-durable-task-step</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-job</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-step-api</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Declarative pipeline (`pipeline { ... }`) support. -->
    <dependency>
      <groupId>org.jenkinsci.plugins</groupId>
      <artifactId>pipeline-model-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Not managed by the Jenkins BOM even at its latest snapshot for
                 this core line (checked 2026-07) - a small, rarely-updated
                 plugin that appears to never have been added to BOM
                 coverage. Pinned by hand, matching internal JSL. -->
      <groupId>org.jenkinsci.plugins</groupId>
      <artifactId>pipeline-model-declarative-agent</artifactId>
      <version>1.1.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkinsci.plugins</groupId>
      <artifactId>pipeline-model-definition</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkinsci.plugins</groupId>
      <artifactId>pipeline-model-extensions</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <plugins>
      <!-- We have real tests now (WithEphemeralCredentialsTest); the
                 parent POM's auto-generated JenkinsRule smoke test
                 (InjectedTest) references a org.jvnet.hudson.test.injected
                 package this jenkins-test-harness version doesn't have. -->
      <plugin>
        <groupId>org.jenkins-ci.tools</groupId>
        <artifactId>maven-hpi-plugin</artifactId>
        <configuration>
          <disabledTestInjection>true</disabledTestInjection>
        </configuration>
      </plugin>

    </plugins>
  </build>
</project>
